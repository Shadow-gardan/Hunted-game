# Server
PORT=4000

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN=http://localhost:5173

# Secret used to sign admin session tokens — use a long random string in production
# Generate one with: openssl rand -base64 48
JWT_SECRET=replace-this-with-a-long-random-string

# Seed credentials for the first admin account (created on first server start only)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-this-with-a-strong-password
